# Build output
bin/
obj/
artifacts/
*.user
*.suo
*.userprefs

# Visual Studio / Rider / VS Code local state
.vs/
.idea/
.vscode/
*.sln.docstates

# Test output
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.trx

# Node
node_modules/
npm-debug.log*
*.tsbuildinfo

# Extension build output. `dist/` is the compiled TypeScript and `host/` the
# published analysis binary: both are produced by `vscode:prepublish`.
dist/
vscode/archon-vscode/host/
*.vsix

# Archon's own accepted-findings file, which is per-checkout
.archon-baseline.json

# Working notes stay local. Only the published documents are tracked: the two
# READMEs and the extension changelog the marketplace renders.
*.md
!README.md
!CHANGELOG.md

# OS
.DS_Store
Thumbs.db
desktop.ini
