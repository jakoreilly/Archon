{
  "rules": {
    "AR0001": "error",
    "AR0005": "off",
    "AR0022": "off",
    "performance": "information"
  },
  "exclude": [
    "**/Generated/**",
    "**/*.Designer.cs"
  ],
  "layers": {
    "mode": "denylist",
    "layers": {
      "Api": [
        "MyApp.Api"
      ],
      "Domain": [
        "MyApp.Domain"
      ],
      "Infrastructure": [
        "MyApp.Infrastructure"
      ]
    },
    "deny": [
      {
        "id": "domain-stays-pure",
        "from": "Domain",
        "to": "Infrastructure"
      },
      {
        "id": "domain-knows-no-api",
        "from": "Domain",
        "to": "Api"
      }
    ]
  },
  "rulePacks": [],
  "overrides": [
    {
      "files": ["tests/**", "**/*Tests.cs"],
      "rules": {
        "AR0073": "off",
        "AR0061": "off",
        "AR0060": "off"
      }
    },
    {
      "files": ["src/MyApp.Payments/**"],
      "rules": {
        "AR0054": "error",
        "security": "error"
      },
      "options": {
        "AR0060": {
          "threshold": 10
        }
      }
    }
  ],
  "baseline": ".archon-baseline.json",
  "options": {
    "SQ0010": {
      "policy": "required"
    },
    "SQ0011": {
      "pattern": "^#tmp[A-Z]"
    },
    "SQ0012": {
      "pattern": "^usp_"
    },
    "AR0030": {
      "additionalSettingsFiles": [
        "config/shared.settings.json"
      ]
    }
  }
}